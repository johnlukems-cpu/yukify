# Voorbeeld van de omgevingsvariabelen. Stel de echte waarden in bij de hosting (Vercel → Settings →
# Environment Variables). Zet NOOIT echte sleutels of wachtwoorden in de repository.

# --- E-mail voor het contactformulier ---
# Optie A (aanbevolen): Resend. Heeft voorrang zodra RESEND_API_KEY is ingesteld.
# API-sleutel uit Resend → API Keys (rechten: "Sending access", domein yukifyadministratie.nl).
RESEND_API_KEY=
# Afzender op het in Resend geverifieerde domein (optioneel, dit is de standaard):
# MAIL_FROM="Yukify Website <contact@yukifyadministratie.nl>"

# Optie B: SMTP via Google Workspace (alleen gebruikt als RESEND_API_KEY leeg is).
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=info@yukifyadministratie.nl
# SMTP_PASS=            (app-wachtwoord, niet het gewone wachtwoord)

# Ontvanger (optioneel, dit is de standaard):
# MAIL_TO=info@yukifyadministratie.nl

# --- Alleen voor eigen Node-hosting (niet nodig op Vercel) ---
# PORT=3000
# TRUST_PROXY=false
# HSTS=false
