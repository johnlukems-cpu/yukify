# Voorbeeld van de omgevingsvariabelen. Stel de echte waarden in bij de hosting (Vercel → Settings →
# Environment Variables). Zet NOOIT echte wachtwoorden in de repository.

# --- E-mail voor het contactformulier (Google Workspace) ---
# Verplicht:
SMTP_HOST=smtp.gmail.com
SMTP_USER=info@yukifyadministratie.nl
# App-wachtwoord van het Google-account hierboven (16 tekens; spaties mogen, die worden genegeerd).
# Niet het gewone wachtwoord van het account. Markeer deze variabele in Vercel als "Sensitive".
SMTP_PASS=

# Optioneel (standaardwaarden tussen haakjes):
# SMTP_PORT=465            (465 = TLS; gebruik 587 alleen samen met SMTP_SECURE=false → STARTTLS)
# SMTP_SECURE=true         (standaard true bij poort 465)
# MAIL_TO=info@yukifyadministratie.nl
# MAIL_FROM moet het SMTP-account zelf zijn of een in Gmail geverifieerde alias; standaard "Yukify website <SMTP_USER>".
# MAIL_FROM="Yukify website <info@yukifyadministratie.nl>"

# --- Alleen voor eigen Node-hosting (niet nodig op Vercel) ---
# PORT=3000
# TRUST_PROXY=false
# HSTS=false
