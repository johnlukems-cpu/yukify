# Kopieer naar je hostingomgeving als omgevingsvariabelen (NIET in de repository zetten met echte waarden).

PORT=3000
# Zet op true als de server achter een reverse proxy/load balancer draait (voor correcte IP's bij rate limiting).
TRUST_PROXY=false
# Zet op true zodra de site uitsluitend via https bereikbaar is.
HSTS=false

# SMTP-gegevens van de mailbox/dienst die de formulierberichten verstuurt (bijv. de mailprovider van info@yukifyadministratie.nl).
SMTP_HOST=
SMTP_PORT=587
# true voor poort 465 (implicit TLS), false voor 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Afzender (moet bij de SMTP-dienst toegestaan zijn, met SPF/DKIM voor yukifyadministratie.nl) en ontvanger van de aanvragen.
MAIL_FROM="Yukify website <info@yukifyadministratie.nl>"
MAIL_TO=info@yukifyadministratie.nl
