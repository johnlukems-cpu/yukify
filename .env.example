# Voorbeeld van de omgevingsvariabelen. Stel de echte waarden in bij de hosting (Vercel → Settings →
# Environment Variables). Zet NOOIT echte sleutels of wachtwoorden in de repository.

# --- E-mail voor het contactformulier ---
# Optie A (aanbevolen): Resend. Heeft voorrang zodra RESEND_API_KEY is ingesteld.
# API-sleutel uit Resend → API Keys (rechten: "Sending access", domein yukifyadministratie.nl).
RESEND_API_KEY=
# Afzender op het in Resend geverifieerde domein (optioneel, dit is de standaard):
# MAIL_FROM="Yukify Website <contact@yukifyadministratie.nl>"

# Optie B: SMTP via Google Workspace (alleen gebruikt als RESEND_API_KEY leeg is).
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=info@yukifyadministratie.nl
# SMTP_PASS=            (app-wachtwoord, niet het gewone wachtwoord)

# Ontvanger (optioneel, dit is de standaard):
# MAIL_TO=info@yukifyadministratie.nl

# --- Beheer Nieuws & Inzichten (/beheer) — zie docs/redactie-workflow.md ---
# Hash van het beheerwachtwoord: maak hem lokaal met `npm run beheer:wachtwoord` (het wachtwoord zelf nergens opslaan).
ADMIN_PASSWORD_HASH=
# Willekeurige tekst van minimaal 32 tekens (ondertekent de sessiecookie). Wijzigen = iedereen uitgelogd.
ADMIN_SESSION_SECRET=
# Naam die bij goedkeuringen wordt vastgelegd (optioneel, standaard "Eigenaar").
# ADMIN_NAME="Voornaam Achternaam"
# Fine-grained GitHub-token, alleen voor deze repository, permissie "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=johnlukems-cpu/yukify
# GITHUB_BRANCH=main

# --- Redactie-API voor Claude/automatisering (alleen concepten; nooit goedkeuren of publiceren) ---
# Willekeurige tekst van minimaal 32 tekens. Leeg = API uitgeschakeld.
REDACTIE_TOKEN=

# --- Dagelijkse publicatieronde voor ingeplande artikelen (Vercel Cron stuurt dit automatisch mee) ---
# Willekeurige tekst van minimaal 32 tekens.
CRON_SECRET=

# --- Alleen voor eigen Node-hosting (niet nodig op Vercel) ---
# PORT=3000
# TRUST_PROXY=false
# HSTS=false
